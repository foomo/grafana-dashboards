											"editorMode": "code",
											"exemplar": true,
											"expr": "(\n  sum by(gotsrpc_package, gotsrpc_service, gotsrpc_func) (\n    rate(\n      gotsrpc_execution_duration_seconds_count{\n        namespace=~\"$namespace\",\n        service=\"$service\",\n        gotsprc_error=\"true\"\n      }[$interval]\n    )\n  ) * 100\n  )\n/\n(\n  sum by(gotsrpc_package, gotsrpc_service, gotsrpc_func) (\n    rate(\n      gotsrpc_execution_duration_seconds_count{\n        namespace=~\"$namespace\",\n        service=\"$service\",\n        gotsprc_error=\"false\"\n      }[$interval]\n    )\n  )\n)\nor\n(\n  0\n  *\n  sum by(gotsrpc_package, gotsrpc_service, gotsrpc_func) (\n    rate(\n      gotsrpc_execution_duration_seconds_count{\n        namespace=~\"$namespace\",\n        service=\"$service\",\n        gotsprc_error=\"false\"\n      }[$interval]\n    )\n  )\n) > 0",
											"interval": "",
											"intervalFactor": 1,
											"legendFormat": "{{gotsrpc_package}}.{{gotsrpc_service}}.({{gotsrpc_func}})",
											"range": true
										},
